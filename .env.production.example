# LingTour production environment template.
# Copy to /root/LingTour/.env on the server and fill real secrets there.

DB_DATABASE=lingtour
DB_USERNAME=lingtour
DB_PASSWORD=change-me
JWT_SECRET=change-me

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://lingfengtranstour.cn/api/v1/auth/google/callback

NEXT_PUBLIC_API_URL=/api/v1
# Server-side Next requests use this private API origin when available.
INTERNAL_API_ORIGIN=http://127.0.0.1:8000/api/v1
# Optional for PM2 deployments. Docker Compose configures redis://redis:6379 itself.
REDIS_URL=redis://127.0.0.1:6379
